  file_change {
    absolute_path_uri: "file:///src/components/AddFoodModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { X, Plus, Heart, Sparkles, Utensils, Check } from \'lucide-react\';\nimport { FoodLog, MealType, FavoriteFood } from \'../types\';\n\ninterface AddFoodModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  selectedDate: string;\n  favoriteFoods: FavoriteFood[];\n  onAddFood: (foodLog: Omit<FoodLog, \'id\'>, saveToFavorites: boolean) => Promise<void>;\n}\n\nexport const AddFoodModal: React.FC<AddFoodModalProps> = ({\n  isOpen,\n  onClose,\n  selectedDate,\n  favoriteFoods,\n  onAddFood,\n}) => {\n  if (!isOpen) return null;\n\n  const [mealType, setMealType] = useState<MealType>(\'lunch\');\n  const [foodName, setFoodName] = useState(\'\');\n  const [calories, setCalories] = useState<string>(\'\');\n  const [proteinGrams, setProteinGrams] = useState<string>(\'0\');\n  const [carbsGrams, setCarbsGrams] = useState<string>(\'0\');\n  const [fatGrams, setFatGrams] = useState<string>(\'0\');\n  const [fiberGrams, setFiberGrams] = useState<string>(\'0\');\n  const [servingAmount, setServingAmount] = useState<string>(\'1\');\n  const [servingUnit, setServingUnit] = useState(\'\344\273\275\');\n  const [saveToFavorites, setSaveToFavorites] = useState(false);\n  const [submitting, setSubmitting] = useState(false);\n  const [searchFav, setSearchFav] = useState(\'\');\n\n  const handleSelectFavorite = (fav: FavoriteFood) => {\n    setFoodName(fav.foodName);\n    setCalories(fav.calories.toString());\n    setProteinGrams(fav.proteinGrams.toString());\n    setCarbsGrams(fav.carbsGrams.toString());\n    setFatGrams(fav.fatGrams.toString());\n    if (fav.defaultServingUnit) {\n      setServingUnit(fav.defaultServingUnit);\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!foodName.trim() || !calories) return;\n\n    setSubmitting(true);\n    try {\n      await onAddFood(\n        {\n          userId: \'\', // set in handler\n          date: selectedDate,\n          mealType,\n          foodName: foodName.trim(),\n          calories: parseFloat(calories) || 0,\n          proteinGrams: parseFloat(proteinGrams) || 0,\n          carbsGrams: parseFloat(carbsGrams) || 0,\n          fatGrams: parseFloat(fatGrams) || 0,\n          fiberGrams: parseFloat(fiberGrams) || 0,\n          servingAmount: parseFloat(servingAmount) || 1,\n          servingUnit,\n        },\n        saveToFavorites\n      );\n      onClose();\n      // Reset\n      setFoodName(\'\');\n      setCalories(\'\');\n      setProteinGrams(\'0\');\n      setCarbsGrams(\'0\');\n      setFatGrams(\'0\');\n      setFiberGrams(\'0\');\n      setSaveToFavorites(false);\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setSubmitting(false);\n    }\n  };\n\n  const filteredFavs = favoriteFoods.filter((f) =>\n    f.foodName.toLowerCase().includes(searchFav.toLowerCase())\n  );\n\n  return (\n    <div id=\"add-food-modal-backdrop\" className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4 overflow-y-auto\">\n      <div className=\"bg-stone-900 border border-stone-800 rounded-2xl w-full max-w-xl p-6 space-y-5 shadow-2xl relative animate-scale-up\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between border-b border-stone-800 pb-3\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"p-2 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\">\n              <Utensils className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2 className=\"text-lg font-bold text-stone-100\">\346\226\260\345\242\236\351\243\262\351\243\237\347\206\261\351\207\217\347\264\200\351\214\204</h2>\n              <p className=\"text-xs text-stone-400\">\346\227\245\346\234\237\357\274\232{selectedDate}</p>\n            </div>\n          </div>\n\n          <button\n            id=\"close-add-food-modal-btn\"\n            onClick={onClose}\n            className=\"p-1.5 text-stone-400 hover:text-stone-100 rounded-lg hover:bg-stone-800 transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Quick Pick from Favorites */}\n        {favoriteFoods.length > 0 && (\n          <div className=\"bg-stone-950/80 border border-stone-800 rounded-xl p-3 space-y-2\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-xs font-bold text-amber-400 flex items-center gap-1\">\n                <Sparkles className=\"w-3.5 h-3.5\" /> \345\276\236\345\270\270\345\220\203\351\243\237\347\211\251\351\273\236\346\223\212\345\277\253\351\200\237\345\245\227\347\224\250\357\274\232\n              </span>\n              <input\n                id=\"modal-search-fav\"\n                type=\"text\"\n                placeholder=\"\346\220\234\345\260\213\345\270\270\345\220\203\351\243\237\347\211\251...\"\n                value={searchFav}\n                onChange={(e) => setSearchFav(e.target.value)}\n                className=\"bg-stone-900 border border-stone-700 rounded-lg px-2 py-0.5 text-xs text-stone-200 focus:outline-none\"\n              />\n            </div>\n\n            <div className=\"flex flex-wrap gap-1.5 max-h-[90px] overflow-y-auto pr-1\">\n              {filteredFavs.slice(0, 10).map((fav) => (\n                <button\n                  key={fav.id || fav.foodName}\n                  type=\"button\"\n                  onClick={() => handleSelectFavorite(fav)}\n                  className=\"px-2.5 py-1 rounded-lg bg-stone-900 hover:bg-emerald-950/80 border border-stone-700/80 hover:border-emerald-500/60 text-xs text-stone-200 hover:text-emerald-300 transition-all flex items-center gap-1.5\"\n                >\n                  <span>{fav.foodName}</span>\n                  <span className=\"text-[10px] text-amber-400 font-bold\">{fav.calories}k</span>\n                </button>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {/* Form */}\n        <form onSubmit={handleSubmit} className=\"space-y-4 text-xs\">\n          {/* Meal Type Selection */}\n          <div className=\"space-y-1.5\">\n            <label className=\"text-stone-300 font-bold block\">\351\201\270\346\223\207\351\244\220\345\210\245</label>\n            <div className=\"grid grid-cols-4 gap-2\">\n              {[\n                { id: \'breakfast\', label: \'\346\227\251\351\244\220\' },\n                { id: \'lunch\', label: \'\345\215\210\351\244\220\' },\n                { id: \'dinner\', label: \'\346\231\232\351\244\220\' },\n                { id: \'snack\', label: \'\351\273\236\345\277\203/\345\256\265\345\244\234\' },\n              ].map((m) => (\n                <button\n                  key={m.id}\n                  type=\"button\"\n                  onClick={() => setMealType(m.id as MealType)}\n                  className={`py-2 px-3 rounded-xl font-bold border transition-all ${\n                    mealType === m.id\n                      ? \'bg-emerald-500/20 text-emerald-400 border-emerald-500\'\n                      : \'bg-stone-950 text-stone-400 border-stone-800 hover:bg-stone-800\'\n                  }`}\n                >\n                  {m.label}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Food Name & Calories */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n            <div className=\"space-y-1\">\n              <label className=\"text-stone-300 font-bold block\">\351\243\237\347\211\251\345\220\215\347\250\261 <span className=\"text-rose-400\">*</span></label>\n              <input\n                id=\"food-name-input\"\n                type=\"text\"\n                required\n                placeholder=\"\344\276\213\345\246\202\357\274\232\351\233\236\350\205\277\344\276\277\347\225\266\343\200\201\347\204\241\347\263\226\351\273\221\345\222\226\345\225\241\"\n                value={foodName}\n                onChange={(e) => setFoodName(e.target.value)}\n                className=\"w-full bg-stone-950 border border-stone-700/80 rounded-xl px-3 py-2 text-stone-100 focus:outline-none focus:border-emerald-500\"\n              />\n            </div>\n\n            <div className=\"space-y-1\">\n              <label className=\"text-stone-300 font-bold block\">\347\206\261\351\207\217 (\345\244\247\345\215\241 / kcal) <span className=\"text-rose-400\">*</span></label>\n              <input\n                id=\"food-calories-input\"\n                type=\"number\"\n                step=\"0.1\"\n                required\n                placeholder=\"\344\276\213\345\246\202\357\274\232550\"\n                value={calories}\n                onChange={(e) => setCalories(e.target.value)}\n                className=\"w-full bg-stone-950 border border-stone-700/80 rounded-xl px-3 py-2 text-stone-100 focus:outline-none focus:border-emerald-500\"\n              />\n            </div>\n          </div>\n\n          {/* Macronutrients (\350\233\213\347\231\275\350\263\252, \346\276\261\347\262\211/\347\242\263\346\260\264, \350\204\202\350\202\252, \350\206\263\351\243\237\347\272\226\347\266\255) */}\n          <div className=\"space-y-1.5 pt-1\">\n            <label className=\"text-stone-300 font-bold block\">\347\207\237\351\244\212\346\210\220\345\210\206 (\345\205\254\345\205\213 / g)</label>\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2\">\n              <div className=\"space-y-1 bg-stone-950 p-2.5 rounded-xl border border-sky-500/20\">\n                <span className=\"text-sky-400 font-bold block\">\350\233\213\347\231\275\350\263\252 (g)</span>\n                <input\n                  id=\"food-protein-input\"\n                  type=\"number\"\n                  step=\"0.1\"\n                  value={proteinGrams}\n                  onChange={(e) => setProteinGrams(e.target.value)}\n                  className=\"w-full bg-stone-900 border border-stone-700 rounded-lg px-2 py-1 text-stone-100 text-xs focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"space-y-1 bg-stone-950 p-2.5 rounded-xl border border-amber-500/20\">\n                <span className=\"text-amber-400 font-bold block\">\346\276\261\347\262\211/\347\242\263\346\260\264 (g)</span>\n                <input\n                  id=\"food-carbs-input\"\n                  type=\"number\"\n                  step=\"0.1\"\n                  value={carbsGrams}\n                  onChange={(e) => setCarbsGrams(e.target.value)}\n                  className=\"w-full bg-stone-900 border border-stone-700 rounded-lg px-2 py-1 text-stone-100 text-xs focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"space-y-1 bg-stone-950 p-2.5 rounded-xl border border-rose-500/20\">\n                <span className=\"text-rose-400 font-bold block\">\350\204\202\350\202\252 (g)</span>\n                <input\n                  id=\"food-fat-input\"\n                  type=\"number\"\n                  step=\"0.1\"\n                  value={fatGrams}\n                  onChange={(e) => setFatGrams(e.target.value)}\n                  className=\"w-full bg-stone-900 border border-stone-700 rounded-lg px-2 py-1 text-stone-100 text-xs focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"space-y-1 bg-stone-950 p-2.5 rounded-xl border border-emerald-500/20\">\n                <span className=\"text-emerald-400 font-bold block\">\347\272\226\347\266\255 (g)</span>\n                <input\n                  id=\"food-fiber-input\"\n                  type=\"number\"\n                  step=\"0.1\"\n                  value={fiberGrams}\n                  onChange={(e) => setFiberGrams(e.target.value)}\n                  className=\"w-full bg-stone-900 border border-stone-700 rounded-lg px-2 py-1 text-stone-100 text-xs focus:outline-none\"\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* Portion Unit & Save To Favorites Checkbox */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 items-center pt-1\">\n            <div className=\"flex gap-2\">\n              <div className=\"w-1/2 space-y-1\">\n                <label className=\"text-stone-400 block\">\344\273\275\351\207\217\346\225\270</label>\n                <input\n                  type=\"number\"\n                  step=\"0.1\"\n                  value={servingAmount}\n                  onChange={(e) => setServingAmount(e.target.value)}\n                  className=\"w-full bg-stone-950 border border-stone-700/80 rounded-xl px-3 py-1.5 text-stone-100\"\n                />\n              </div>\n              <div className=\"w-1/2 space-y-1\">\n                <label className=\"text-stone-400 block\">\345\226\256\344\275\215</label>\n                <input\n                  type=\"text\"\n                  placeholder=\"\344\273\275 / \347\242\227 / 100g\"\n                  value={servingUnit}\n                  onChange={(e) => setServingUnit(e.target.value)}\n                  className=\"w-full bg-stone-950 border border-stone-700/80 rounded-xl px-3 py-1.5 text-stone-100\"\n                />\n              </div>\n            </div>\n\n            <label className=\"flex items-center space-x-2 cursor-pointer bg-stone-950 border border-stone-800 p-2.5 rounded-xl hover:border-amber-500/40 transition-colors\">\n              <input\n                type=\"checkbox\"\n                checked={saveToFavorites}\n                onChange={(e) => setSaveToFavorites(e.target.checked)}\n                className=\"w-4 h-4 text-emerald-500 rounded focus:ring-emerald-500 bg-stone-900 border-stone-700\"\n              />\n              <span className=\"text-stone-200 font-medium flex items-center gap