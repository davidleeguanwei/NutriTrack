        }
        lines {
          text: "    const w = parseFloat(weightInput);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (isNaN(w) || w <= 0 || w > 300) return;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    setSubmitting(true);"
