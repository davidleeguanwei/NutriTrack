  file_change {
    absolute_path_uri: "file:///src/components/FavoriteFoodManager.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Heart, \n  Plus, \n  Search, \n  Trash2, \n  Check, \n  X\n} from \'lucide-react\';\nimport { FavoriteFood, MealType } from \'../types\';\n\ninterface FavoriteFoodManagerProps {\n  favoriteFoods: FavoriteFood[];\n  onAddFavorite: (fav: Omit<FavoriteFood, \'id\'>) => Promise<void>;\n  onDeleteFavorite: (id: string) => Promise<void>;\n  onLogFavoriteToDate: (fav: FavoriteFood, mealType: MealType) => Promise<void>;\n}\n\nexport const FavoriteFoodManager: React.FC<FavoriteFoodManagerProps> = ({\n  favoriteFoods,\n  onAddFavorite,\n  onDeleteFavorite,\n  onLogFavoriteToDate,\n}) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'all\');\n  const [isAddOpen, setIsAddOpen] = useState(false);\n\n  // Form states for new favorite food\n  const [foodName, setFoodName] = useState(\'\');\n  const [calories, setCalories] = useState(\'\');\n  const [proteinGrams, setProteinGrams] = useState(\'0\');\n  const [carbsGrams, setCarbsGrams] = useState(\'0\');\n  const [fatGrams, setFatGrams] = useState(\'0\');\n  const [defaultServingUnit, setDefaultServingUnit] = useState(\'1 \344\273\275\');\n  const [category, setCategory] = useState(\'\351\253\230\350\233\213\347\231\275\350\263\252\');\n  const [submitting, setSubmitting] = useState(false);\n\n  // Selected meal for quick logging\n  const [quickMealType, setQuickMealType] = useState<MealType>(\'lunch\');\n  const [loggedNotification, setLoggedNotification] = useState<string | null>(null);\n\n  const categories = [\'all\', \'\351\253\230\350\233\213\347\231\275\350\263\252\', \'\345\205\250\347\251\200\351\233\234\347\263\247\', \'\350\224\254\350\217\234\346\260\264\346\236\234\', \'\351\243\262\346\226\231\', \'\345\201\245\345\272\267\351\273\236\345\277\203\', \'\345\205\266\344\273\226\'];\n\n  const filteredFoods = favoriteFoods.filter((f) => {\n    const matchesSearch = f.foodName.toLowerCase().includes(searchTerm.toLowerCase());\n    const matchesCategory = selectedCategory === \'all\' || f.category === selectedCategory;\n    return matchesSearch && matchesCategory;\n  });\n\n  const handleAddSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!foodName || !calories) return;\n\n    setSubmitting(true);\n    try {\n      await onAddFavorite({\n        userId: \'\',\n        foodName: foodName.trim(),\n        calories: parseFloat(calories) || 0,\n        proteinGrams: parseFloat(proteinGrams) || 0,\n        carbsGrams: parseFloat(carbsGrams) || 0,\n        fatGrams: parseFloat(fatGrams) || 0,\n        defaultServingUnit,\n        category,\n      });\n\n      // Reset\n      setFoodName(\'\');\n      setCalories(\'\');\n      setProteinGrams(\'0\');\n      setCarbsGrams(\'0\');\n      setFatGrams(\'0\');\n      setIsAddOpen(false);\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setSubmitting(false);\n    }\n  };\n\n  const handleQuickLog = async (fav: FavoriteFood) => {\n    try {\n      await onLogFavoriteToDate(fav, quickMealType);\n      setLoggedNotification(`\345\267\262\346\226\260\345\242\236 ${fav.foodName} \345\210\260\344\273\212\346\227\245 ${\n        quickMealType === \'breakfast\' ? \'\346\227\251\351\244\220\' : quickMealType === \'lunch\' ? \'\345\215\210\351\244\220\' : quickMealType === \'dinner\' ? \'\346\231\232\351\244\220\' : \'\351\273\236\345\277\203\'\n      }`);\n      setTimeout(() => setLoggedNotification(null), 3000);\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  return (\n    <div id=\"favorite-foods-view\" className=\"space-y-6 animate-fade-in\">\n      {/* Header Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white border border-slate-200 p-6 rounded-2xl shadow-xs\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-bold text-rose-700 bg-rose-50 border border-rose-200 px-2.5 py-0.5 rounded-full flex items-center gap-1\">\n              <Heart className=\"w-3.5 h-3.5 fill-rose-600 text-rose-600\" /> \345\270\270\345\220\203\351\243\237\347\211\251\345\226\256\n            </span>\n            <span className=\"text-xs text-slate-500 font-medium\">\345\204\262\345\255\230\346\227\245\345\270\270\351\253\230\351\240\273\347\216\207\351\244\220\351\273\236</span>\n          </div>\n          <h1 className=\"text-2xl font-bold text-slate-900 mt-1.5\">\n            \345\270\270\345\220\203\351\243\237\347\211\251\345\272\253\350\210\207\344\270\200\351\215\265\347\264\200\351\214\204\n          </h1>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            \350\207\252\345\256\232\347\276\251\351\240\220\350\250\255\351\243\237\347\211\251\350\210\207\345\215\241\350\267\257\351\207\214\357\274\214\346\234\252\344\276\206\344\270\200\351\215\265\345\215\263\345\217\257\347\233\264\346\216\245\344\273\243\345\205\245\346\257\217\346\227\245\351\243\262\351\243\237\346\227\245\350\250\230\357\274\214\345\244\247\345\271\205\347\257\200\347\234\201\346\231\202\351\226\223\357\274\201\n          </p>\n        </div>\n\n        <button\n          id=\"open-add-favorite-modal-btn\"\n          onClick={() => setIsAddOpen(true)}\n          className=\"flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-xs transition-all\"\n        >\n          <Plus className=\"w-4 h-4 stroke-[2.5]\" />\n          <span>\345\273\272\347\253\213\346\226\260\345\270\270\345\220\203\351\243\237\347\211\251</span>\n        </button>\n      </div>\n\n      {/* Notification Toast */}\n      {loggedNotification && (\n        <div className=\"bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-2.5 rounded-xl text-xs font-bold flex items-center gap-2 shadow-xs\">\n          <Check className=\"w-4 h-4 text-emerald-600\" />\n          <span>{loggedNotification}</span>\n        </div>\n      )}\n\n      {/* Search & Category Filter Bar */}\n      <div className=\"bg-white border border-slate-200 rounded-2xl p-5 space-y-3 shadow-xs\">\n        <div className=\"flex flex-col sm:flex-row items-center gap-3\">\n          {/* Search Input */}\n          <div className=\"relative flex-1 w-full\">\n            <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-2.5\" />\n            <input\n              id=\"search-favorite-input\"\n              type=\"text\"\n              placeholder=\"\346\220\234\345\260\213\345\270\270\345\220\203\351\243\237\347\211\251\345\220\215\347\250\261...\"\n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              className=\"w-full bg-slate-50 border border-slate-300 rounded-xl pl-9 pr-3 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-emerald-500 focus:bg-white\"\n            />\n          </div>\n\n          {/* Meal Type selector for quick logging */}\n          <div className=\"flex items-center space-x-2 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-xl text-xs\">\n            <span className=\"text-slate-600 font-semibold\">\345\277\253\351\200\237\347\264\200\351\214\204\350\207\263\357\274\232</span>\n            <select\n              value={quickMealType}\n              onChange={(e) => setQuickMealType(e.target.value as MealType)}\n              className=\"bg-white text-emerald-700 font-bold focus:outline-none cursor-pointer rounded border border-slate-300 px-1.5 py-0.5\"\n            >\n              <option value=\"breakfast\">\346\227\251\351\244\220</option>\n              <option value=\"lunch\">\345\215\210\351\244\220</option>\n              <option value=\"dinner\">\346\231\232\351\244\220</option>\n              <option value=\"snack\">\351\273\236\345\277\203/\345\256\265\345\244\234</option>\n            </select>\n          </div>\n        </div>\n\n        {/* Categories Pills */}\n        <div className=\"flex flex-wrap gap-1.5 pt-1\">\n          {categories.map((cat) => (\n            <button\n              key={cat}\n              onClick={() => setSelectedCategory(cat)}\n              className={`px-3 py-1 rounded-lg text-xs font-semibold transition-all ${\n                selectedCategory === cat\n                  ? \'bg-emerald-50 text-emerald-700 border border-emerald-300 shadow-2xs\'\n                  : \'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200\'\n              }`}\n            >\n              {cat === \'all\' ? \'\345\205\250\351\203\250\347\250\256\351\241\236\' : cat}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Grid of Favorite Foods */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {filteredFoods.map((fav) => (\n          <div\n            key={fav.id || fav.foodName}\n            className=\"bg-white border border-slate-200 hover:border-slate-300 rounded-2xl p-5 space-y-3 shadow-xs transition-all flex flex-col justify-between\"\n          >\n            <div>\n              <div className=\"flex items-start justify-between\">\n                <div className=\"space-y-0.5\">\n                  <div className=\"flex items-center gap-2\">\n                    <h3 className=\"font-bold text-slate-900 text-base\">{fav.foodName}</h3>\n                    {fav.category && (\n                      <span className=\"text-[10px] text-rose-700 bg-rose-50 border border-rose-200 px-2 py-0.5 rounded-full font-semibold\">\n                        {fav.category}\n                      </span>\n                    )}\n                  </div>\n                  <p className=\"text-xs text-slate-500\">\346\250\231\346\272\226\344\273\275\351\207\217\357\274\232{fav.defaultServingUnit || \'1 \344\273\275\'}</p>\n                </div>\n\n                <span className=\"text-lg font-bold text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-xl\">\n                  {fav.calories} <span className=\"text-xs font-medium text-slate-500\">kcal</span>\n                </span>\n              </div>\n\n              {/* Macro stats */}\n              <div className=\"grid grid-cols-3 gap-2 mt-3 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-[11px] font-mono text-slate-600\">\n                <div className=\"text-center\">\n                  <span className=\"text-blue-600 font-bold block\">{fav.proteinGrams}g</span>\n                  <span className=\"text-[10px] text-slate-400\">\350\233\213\347\231\275\350\263\252</span>\n                </div>\n                <div className=\"text-center\">\n                  <span className=\"text-amber-600 font-bold block\">{fav.carbsGrams}g</span>\n                  <span className=\"text-[10px] text-slate-400\">\346\276\261\347\262\211/\347\242\263\346\260\264</span>\n                </div>\n                <div className=\"text-center\">\n                  <span className=\"text-rose-600 font-bold block\">{fav.fatGrams}g</span>\n                  <span className=\"text-[10px] text-slate-400\">\350\204\202\350\202\252</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Action buttons */}\n            <div className=\"flex items-center justify-between pt-3 border-t border-slate-100\">\n              {fav.id && (\n                <button\n                  onClick={() => onDeleteFavorite(fav.id!)}\n                  className=\"p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors\"\n                  title=\"\345\276\236\345\270\270\345\220\203\351\243\237\347\211\251\345\272\253\347\247\273\351\231\244\"\n                >\n                  <Trash2 className=\"w-4 h-4\" />\n                </button>\n              )}\n\n              <button\n                onClick={() => handleQuickLog(fav)}\n                className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-all shadow-2xs ml-auto\"\n              >\n                <Plus className=\"w-3.5 h-3.5 stroke-[2.5]\" />\n                <span>\345\212\240\345\205\245\344\273\212\346\227\245\351\243\262\351\243\237</span>\n              </button>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Add New Favorite Food Modal */}\n      {isAddOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4\">\n          <div className=\"bg-white border border-slate-200 rounded-2xl w-full max-w-lg p-6 space-y-4 shadow-xl\">\n            <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n              <h3 className=\"text-base font-bold text-slate-900 flex items-center gap-2\">\n                <Heart className=\"w-4 h-4 text-rose-600 fill-rose-100\" /> \346\226\260\345\242\236\350\207\263\345\270\270\345\220\203\351\243\237\347\211\251\345\272\253\n              </h3>\n              <button\n                onClick={() => setIsAddOpen(false)}\n                className=\"text-slate-400 hover:text-slate-700\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <form onSubmit={handleAddSubmit} className=\"space-y-3 text-xs\">\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div className=\"space-y-1\">\n                  <label className=\"text-slate-900 font-bold block\">\351\243\237\347\211\251\345\220\215\347\250\261</label>\n                  <input\n                    type=\"text\"\n                    required\n                    placeholder=\"\344\276\213\345\246\202\357\274\232\345\234\260\347\223\234\343\200\201\351\273\221\345\222\226\345\225\241\"\n                    value={foodName}\n                    onChange={(e) => setFoodName(e.target.value)}\n                    className=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-slate-900 focus:outline-none focus:border-emerald-500 focus:bg-white\"\n                  />\n                </div>\n\n                <div className=\"space-y-1\">\n                  <label className=\"text-slate-900 font-bold block\">\345\215\241\350\267\257\351\207\214 (kcal)</label>\n                  <input\n                    type=\"number\"\n                    required\n                    placeholder=\"\344\276\213\345\246\202\357\274\232140\"\n                    value={calories}\n                    onChange={(e) => setCalories(e.target.value)}\n                    className=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-slate-900 focus:outline-none focus:border-emerald-500 focus:bg-white\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-3 gap-2\">\n                <div className=\"space-y-1 bg-slate-50 p-2.5 rounded-xl border border-blue-100\">\n                  <span className=\"text-blue-600 font-bold block\">\350\233\213\347\231\275\350\263\252 (g)</span>\n                  <input\n                    type=\"number\"\n                    step=\"0.1\"\n                    value={proteinGrams}\n                    onChange={(e) => setProteinGrams(e.target.value)}\n                    className=\"w-full bg-white border border-slate-300 rounded-lg px-2 py-1 text-slate-900 text-xs\"\n                  />\n                </div>\n\n                <div className=\"space-y-1 bg-slate-50 p-2.5 rounded-xl border border-amber-100\">\n                  <span className=\"text-amber-600 font-bold block\">\346\276\261\347\262\211/\347\242\263\346\260\264 (g)</span>\n                  <input\n                    type=\"number\"\n                    step=\"0.1\"\n                    value={carbsGrams}\n                    onChange={(e) => setCarbsGrams(e.target.value)}\n                    className=\"w-full bg-white border border-slate-300 rounded-lg px-2 py-1 text-slate-900 text-xs\"\n                  />\n                </div>\n\n                <div className=\"space-y-1 bg-slate-50 p-2.5 rounded-xl border border-rose-100\">\n                  <span className=\"text-rose-600 font-bold block\">\350\204\202\350\202\252 (g)</span>\n                  <input\n                    type=\"number\"\n                    step=\"0.1\"\n                    value={fatGrams}\n                    onChange={(e) => setFatGrams(e.target.value)}\n                    className=\"w-full bg-white border border-slate-300 rounded-lg px-2 py-1 text-slate-900 text-xs\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div className=\"space-y-1\">\n                  <label className=\"text-slate-900 font-bold block\">\346\250\231\346\272\226\351\240\220\350\250\255\345\226\256\344\275\215</label>\n                  <input\n                    type=\"text\"\n                    value={defaultServingUnit}\n                    onChange={(e) => setDefaultServingUnit(e.target.value)}\n                    className=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-slate-900 focus:bg-white\"\n                  />\n                </div>\n\n                <div className=\"space-y-1\">\n                  <label className=\"text-slate-900 font-bold block\">\351\243\237\347\211\251\345\210\206\351\241\236</label>\n                  <select\n                    value={category}\n                    onChange={(e) => setCategory(e.target.value)}\n                    className=\"w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-slate-900 focus:bg-white\"\n                  >\n                    <option value=\"\351\253\230\350\233\213\347\231\275\350\263\252\">\351\253\230\350\233\213\347\231\275\350\263\252</option>\n                    <option value=\"\345\205\250\347\251\200\351\233\234\347\263\247\">\345\205\250\347\251\200\351\233\234\347\263\247</option>\n                    <option value=\"\350\224\254\350\217\234\346\260\264\346\236\234\">\350\224\254\350\217\234\346\260\264\346\236\234</option>\n                    <option value=\"\351\243\262\346\226\231\">\351\243\262\346\226\231</option>\n                    <option value=\"\345\201\245\345\272\267\351\273\236\345\277\203\">\345\201\245\345\272\267\351\273\236\345\277\203</option>\n                    <option value=\"\345\205\266\344\273\226\">\345\205\266\344\273\226</option>\n                  </select>\n                </div>\n              </div>\n\n              <div className=\"flex justify-end space-x-2 pt-3 border-t border-slate-100\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsAddOpen(false)}\n                  className=\"px-4 py-2 rounded-xl bg-slate-100 text-slate-700 font-semibold\"\n                >\n                  \345\217\226\346\266\210\n                </button>\n                <button\n                  type=\"submit\"\n                  disabled={submitting}\n                  className=\"px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold shadow-xs\"\n                >\n                  {submitting ? \'\345\204\262\345\255\230\344\270\255...\' : \'\345\204\262\345\255\230\350\207\263\345\270\270\345\220\203\345\272\253\'}\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
