  file_change {
    absolute_path_uri: "file:///src/components/FoodLogSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { \n  Plus, \n  Trash2, \n  Sparkles, \n  Coffee, \n  Sun, \n  Moon, \n  Cookie\n} from \'lucide-react\';\nimport { FoodLog, MealType, FavoriteFood } from \'../types\';\nimport { formatDateLabel } from \'../lib/calculator\';\n\ninterface FoodLogSectionProps {\n  foodLogs: FoodLog[];\n  selectedDate: string;\n  favoriteFoods: FavoriteFood[];\n  onOpenAddModal: () => void;\n  onDeleteLog: (id: string) => void;\n  onQuickAddFavoriteFood: (fav: FavoriteFood) => void;\n}\n\nexport const FoodLogSection: React.FC<FoodLogSectionProps> = ({\n  foodLogs,\n  selectedDate,\n  favoriteFoods,\n  onOpenAddModal,\n  onDeleteLog,\n  onQuickAddFavoriteFood,\n}) => {\n  const totalCalories = foodLogs.reduce((acc, item) => acc + item.calories, 0);\n  const totalProtein = foodLogs.reduce((acc, item) => acc + item.proteinGrams, 0);\n  const totalCarbs = foodLogs.reduce((acc, item) => acc + item.carbsGrams, 0);\n  const totalFat = foodLogs.reduce((acc, item) => acc + item.fatGrams, 0);\n\n  const meals: { id: MealType; label: string; icon: React.ReactNode; color: string }[] = [\n    { id: \'breakfast\', label: \'\346\227\251\351\244\220 (Breakfast)\', icon: <Coffee className=\"w-4 h-4 text-amber-600\" />, color: \'amber\' },\n    { id: \'lunch\', label: \'\345\215\210\351\244\220 (Lunch)\', icon: <Sun className=\"w-4 h-4 text-emerald-600\" />, color: \'emerald\' },\n    { id: \'dinner\', label: \'\346\231\232\351\244\220 (Dinner)\', icon: <Moon className=\"w-4 h-4 text-blue-600\" />, color: \'blue\' },\n    { id: \'snack\', label: \'\351\273\236\345\277\203/\345\256\265\345\244\234 (Snack)\', icon: <Cookie className=\"w-4 h-4 text-purple-600\" />, color: \'purple\' },\n  ];\n\n  return (\n    <div id=\"foodlog-view\" className=\"space-y-6 animate-fade-in\">\n      {/* Header Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white border border-slate-200 p-6 rounded-2xl shadow-xs\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full\">\n              {formatDateLabel(selectedDate)}\n            </span>\n            <span className=\"text-xs text-slate-500 font-medium\">\346\257\217\346\227\245\351\243\262\351\243\237\350\250\230\351\214\204\350\210\207\346\210\220\345\210\206\346\213\206\350\247\243</span>\n          </div>\n          <h1 className=\"text-2xl font-bold text-slate-900 mt-1.5 flex items-center gap-2\">\n            \351\243\262\351\243\237\346\227\245\350\250\230\350\210\207\346\210\220\345\210\206\350\251\263\347\264\260\350\263\207\350\250\212\n          </h1>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            \347\225\266\346\227\245\347\264\200\351\214\204\347\206\261\351\207\217\357\274\232<strong className=\"text-emerald-600 font-bold\">{totalCalories}</strong> kcal | \n            \350\233\213\347\231\275\350\263\252 <strong className=\"text-blue-600\">{totalProtein}g</strong> | \n            \347\242\263\346\260\264 <strong className=\"text-amber-600\">{totalCarbs}g</strong> | \n            \350\204\202\350\202\252 <strong className=\"text-rose-600\">{totalFat}g</strong>\n          </p>\n        </div>\n\n        <button\n          id=\"add-food-log-section-btn\"\n          onClick={onOpenAddModal}\n          className=\"flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-xs transition-all\"\n        >\n          <Plus className=\"w-4 h-4 stroke-[2.5]\" />\n          <span>\346\226\260\345\242\236\351\243\237\347\211\251\347\264\200\351\214\204</span>\n        </button>\n      </div>\n\n      {/* Quick Select from Favorites Bar */}\n      {favoriteFoods.length > 0 && (\n        <div className=\"bg-white border border-slate-200 rounded-2xl p-5 space-y-2.5 shadow-xs\">\n          <span className=\"text-xs font-bold text-emerald-700 flex items-center gap-1.5\">\n            <Sparkles className=\"w-4 h-4 text-emerald-600\" /> \344\270\200\351\215\265\345\276\236\343\200\214\345\270\270\345\220\203\351\243\237\347\211\251\345\272\253\343\200\215\345\212\240\345\205\245\344\273\212\346\227\245\351\243\262\351\243\237\357\274\232\n          </span>\n          <div className=\"flex flex-wrap gap-2 overflow-x-auto pb-0.5\">\n            {favoriteFoods.map((fav) => (\n              <button\n                key={fav.id || fav.foodName}\n                onClick={() => onQuickAddFavoriteFood(fav)}\n                className=\"px-3 py-1.5 rounded-xl bg-slate-50 hover:bg-emerald-50 border border-slate-200 hover:border-emerald-300 text-xs text-slate-800 hover:text-emerald-700 transition-all flex items-center gap-2 group shadow-2xs\"\n              >\n                <span className=\"font-semibold\">{fav.foodName}</span>\n                <span className=\"text-emerald-600 font-bold text-[11px]\">\n                  +{fav.calories} kcal\n                </span>\n              </button>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* Meals Grouped Sections */}\n      <div className=\"space-y-4\">\n        {meals.map((meal) => {\n          const mealLogs = foodLogs.filter((f) => f.mealType === meal.id);\n          const mealCalories = mealLogs.reduce((sum, item) => sum + item.calories, 0);\n\n          return (\n            <div\n              key={meal.id}\n              className=\"bg-white border border-slate-200 rounded-2xl p-6 space-y-3 shadow-xs\"\n            >\n              {/* Meal Header */}\n              <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n                <div className=\"flex items-center space-x-2.5\">\n                  <div className=\"p-2 rounded-xl bg-slate-50 border border-slate-200\">\n                    {meal.icon}\n                  </div>\n                  <h3 className=\"text-sm font-bold text-slate-900\">{meal.label}</h3>\n                  <span className=\"text-xs text-slate-500 font-normal\">\n                    ({mealLogs.length} \351\240\205\347\264\200\351\214\204)\n                  </span>\n                </div>\n\n                <div className=\"flex items-center space-x-3\">\n                  <span className=\"text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200 px-3 py-1 rounded-lg\">\n                    {mealCalories} kcal\n                  </span>\n                  <button\n                    onClick={onOpenAddModal}\n                    className=\"p-1.5 text-slate-400 hover:text-emerald-600 rounded-lg hover:bg-slate-100 transition-colors\"\n                    title=\"\345\234\250\346\255\244\351\244\220\345\210\245\346\226\260\345\242\236\347\264\200\351\214\204\"\n                  >\n                    <Plus className=\"w-4 h-4\" />\n                  </button>\n                </div>\n              </div>\n\n              {/* Logs List for Meal */}\n              {mealLogs.length === 0 ? (\n                <p className=\"text-xs text-slate-400 italic py-2 pl-2\">\n                  \345\260\232\346\234\252\347\231\273\351\214\204{meal.label.split(\' \')[0]}\351\244\220\351\273\236\357\274\214\351\273\236\346\223\212\343\200\214+\343\200\215\345\215\263\345\217\257\350\250\230\351\214\204\343\200\202\n                </p>\n              ) : (\n                <div className=\"divide-y divide-slate-100\">\n                  {mealLogs.map((log) => (\n                    <div\n                      key={log.id || log.foodName + log.calories}\n                      className=\"py-3 flex items-center justify-between hover:bg-slate-50/80 px-2 rounded-xl transition-colors group text-xs\"\n                    >\n                      <div className=\"space-y-0.5\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className=\"font-bold text-slate-900 text-sm\">{log.foodName}</span>\n                          {log.servingAmount && (\n                            <span className=\"text-[11px] text-slate-500 bg-slate-100 px-2 py-0.5 rounded border border-slate-200 font-medium\">\n                              {log.servingAmount} {log.servingUnit || \'\344\273\275\'}\n                            </span>\n                          )}\n                        </div>\n\n                        {/* Nutrient details */}\n                        <div className=\"flex items-center gap-3 text-[11px] text-slate-500 font-mono\">\n                          <span>\350\233\213\347\231\275: <strong className=\"text-blue-600 font-bold\">{log.proteinGrams}g</strong></span>\n                          <span>\347\242\263\346\260\264: <strong className=\"text-amber-600 font-bold\">{log.carbsGrams}g</strong></span>\n                          <span>\350\204\202\350\202\252: <strong className=\"text-rose-600 font-bold\">{log.fatGrams}g</strong></span>\n                          {log.fiberGrams ? <span>\347\272\226\347\266\255: <strong className=\"text-emerald-600 font-bold\">{log.fiberGrams}g</strong></span> : null}\n                        </div>\n                      </div>\n\n                      <div className=\"flex items-center space-x-3\">\n                        <span className=\"font-extrabold text-amber-600 text-sm\">\n                          {log.calories} <span className=\"text-[10px] font-medium text-slate-500\">kcal</span>\n                        </span>\n                        {log.id && (\n                          <button\n                            onClick={() => onDeleteLog(log.id!)}\n                            className=\"p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors\"\n                            title=\"\345\210\252\351\231\244\347\264\200\351\214\204\"\n                          >\n                            <Trash2 className=\"w-3.5 h-3.5\" />\n                          </button>\n                        )}\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              )}\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
