        lines {
          text: "  const snackCals = foodLogs.filter(f => f.mealType === \'snack\').reduce((a, b) => a + b.calories, 0);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Macro calories"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const proteinCals = totalProtein * 4;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const carbsCals = totalCarbs * 4;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const fatCals = totalFat * 9;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const totalMacroCals = proteinCals + carbsCals + fatCals || 1;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const proteinPct = Math.round((proteinCals / totalMacroCals) * 100);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const carbsPct = Math.round((carbsCals / totalMacroCals) * 100);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const fatPct = Math.round((fatCals / totalMacroCals) * 100);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
