        }
        lines {
          text: "    try {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      await onSaveWeight(logDate, w, noteInput);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      setNoteInput(\'\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
