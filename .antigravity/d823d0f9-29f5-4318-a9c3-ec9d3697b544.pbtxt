          text: "  const [logDate, setLogDate] = useState(selectedDate || getTodayString());"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const [weightInput, setWeightInput] = useState(profile.weight ? profile.weight.toString() : \'\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const [noteInput, setNoteInput] = useState(\'\');"
