  file_change {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { User } from \'firebase/auth\';\nimport { \n  Flame, \n  Droplet, \n  Scale, \n  Calendar, \n  LogOut, \n  LogIn, \n  User as UserIcon, \n  UtensilsCrossed, \n  Heart, \n  Settings, \n  Sparkles,\n  LayoutDashboard\n} from \'lucide-react\';\nimport { formatDateLabel, getTodayString } from \'../lib/calculator\';\n\ninterface NavbarProps {\n  user: User | null;\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n  selectedDate: string;\n  setSelectedDate: (date: string) => void;\n  onGoogleSignIn: () => void;\n  onGuestSignIn: () => void;\n  onSignOut: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  user,\n  activeTab,\n  setActiveTab,\n  selectedDate,\n  setSelectedDate,\n  onGoogleSignIn,\n  onGuestSignIn,\n  onSignOut,\n}) => {\n  const isToday = selectedDate === getTodayString();\n\n  return (\n    <header id=\"main-header\" className=\"sticky top-0 z-40 bg-stone-900/95 backdrop-blur-md border-b border-stone-800 text-stone-100 shadow-md\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16\">\n          {/* Brand Logo */}\n          <div className=\"flex items-center space-x-3\">\n            <button \n              id=\"brand-logo-button\"\n              onClick={() => setActiveTab(\'dashboard\')} \n              className=\"flex items-center space-x-2 text-left group focus:outline-none\"\n            >\n              <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center text-stone-950 font-bold shadow-lg shadow-emerald-500/20 group-hover:scale-105 transition-transform\">\n                <Flame className=\"w-6 h-6 text-stone-950 fill-stone-950\" />\n              </div>\n              <div>\n                <span className=\"text-xl font-black tracking-tight text-white flex items-center gap-1\">\n                  NutriTrack\n                  <span className=\"text-xs px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-medium\">\n                    \347\206\261\351\207\217\346\227\245\350\252\214\n                  </span>\n                </span>\n                <span className=\"text-xs text-stone-400 block -mt-1 font-sans\">\n                  \345\201\245\345\272\267\351\243\262\351\243\237\350\210\207\351\253\224\351\207\215\347\256\241\347\220\206\n                </span>\n              </div>\n            </button>\n          </div>\n\n          {/* Date Selector */}\n          <div className=\"hidden md:flex items-center bg-stone-800/80 border border-stone-700/60 rounded-xl px-3 py-1.5 space-x-2\">\n            <Calendar className=\"w-4 h-4 text-emerald-400\" />\n            <input\n              id=\"header-date-input\"\n              type=\"date\"\n              value={selectedDate}\n              onChange={(e) => setSelectedDate(e.target.value)}\n              className=\"bg-transparent text-sm text-stone-200 focus:outline-none font-medium cursor-pointer\"\n            />\n            <span className=\"text-xs text-emerald-400 font-semibold px-2 py-0.5 rounded bg-emerald-500/10\">\n              {formatDateLabel(selectedDate)}\n            </span>\n            {!isToday && (\n              <button\n                id=\"reset-today-btn\"\n                onClick={() => setSelectedDate(getTodayString())}\n                className=\"text-xs text-stone-400 hover:text-white underline ml-1\"\n              >\n                \345\233\236\345\210\260\344\273\212\345\244\251\n              </button>\n            )}\n          </div>\n\n          {/* User Auth Info */}\n          <div className=\"flex items-center space-x-3\">\n            {user ? (\n              <div className=\"flex items-center space-x-3\">\n                <div className=\"flex items-center space-x-2 bg-stone-800/70 border border-stone-700 rounded-full py-1 px-3\">\n                  {user.photoURL ? (\n                    <img \n                      src={user.photoURL} \n                      alt=\"Avatar\" \n                      className=\"w-6 h-6 rounded-full ring-2 ring-emerald-500/50\" \n                      referrerPolicy=\"no-referrer\"\n                    />\n                  ) : (\n                    <div className=\"w-6 h-6 rounded-full bg-emerald-600 flex items-center justify-center text-xs font-bold text-white\">\n                      {user.displayName?.[0] || \'U\'}\n                    </div>\n                  )}\n                  <span className=\"text-xs font-medium text-stone-200 max-w-[100px] truncate\">\n                    {user.isAnonymous ? \'\350\250\252\345\256\242\345\270\263\350\231\237\' : (user.displayName || user.email?.split(\'@\')[0])}\n                  </span>\n                </div>\n                <button\n                  id=\"signout-button\"\n                  onClick={onSignOut}\n                  title=\"\347\231\273\345\207\272\345\270\263\350\231\237\"\n                  className=\"p-2 rounded-lg text-stone-400 hover:text-stone-100 hover:bg-stone-800 transition-colors\"\n                >\n                  <LogOut className=\"w-4 h-4\" />\n                </button>\n              </div>\n            ) : (\n              <div className=\"flex items-center space-x-2\">\n                <button\n                  id=\"google-signin-button\"\n                  onClick={onGoogleSignIn}\n                  className=\"flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-stone-950 text-xs font-bold transition-all shadow-md shadow-emerald-500/20\"\n                >\n                  <LogIn className=\"w-3.5 h-3.5\" />\n                  <span>Google \347\231\273\345\205\245</span>\n                </button>\n                <button\n                  id=\"guest-signin-button\"\n                  onClick={onGuestSignIn}\n                  className=\"px-2.5 py-1.5 rounded-lg bg-stone-800 hover:bg-stone-700 text-stone-300 text-xs font-medium border border-stone-700 transition-colors\"\n                >\n                  \350\250\252\345\256\242\350\251\246\347\224\250\n                </button>\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Navigation Tabs Bar */}\n        <nav id=\"nav-tab-menu\" className=\"flex space-x-1 overflow-x-auto py-2 scrollbar-none border-t border-stone-800/80\">\n          <button\n            id=\"nav-tab-dashboard\"\n            onClick={() => setActiveTab(\'dashboard\')}\n            className={`flex items-center space-x-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all ${\n              activeTab === \'dashboard\'\n                ? \'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 shadow-sm\'\n                : \'text-stone-400 hover:text-stone-200 hover:bg-stone-800/50\'\n            }`}\n          >\n            <LayoutDashboard className=\"w-4 h-4\" />\n            <span>\347\270\275\350\246\275\345\204\200\350\241\250\346\235\277</span>\n          </button>\n\n          <button\n            id=\"nav-tab-foodlog\"\n            onClick={() => setActiveTab(\'foodlog\')}\n            className={`flex items-center space-x-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all ${\n              activeTab === \'foodlog\'\n                ? \'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 shadow-sm\'\n                : \'text-stone-400 hover:text-stone-200 hover:bg-stone-800/50\'\n            }`}\n          >\n            <UtensilsCrossed className=\"w-4 h-4\" />\n            <span>\351\243\262\351\243\237\347\264\200\351\214\204</span>\n          </button>\n\n          <button\n            id=\"nav-tab-favorites\"\n            onClick={() => setActiveTab(\'favorites\')}\n            className={`flex items-center space-x-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all ${\n              activeTab === \'favorites\'\n                ? \'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 shadow-sm\'\n                : \'text-stone-400 hover:text-stone-200 hover:bg-stone-800/50\'\n            }`}\n          >\n            <Heart className=\"w-4 h-4 text-rose-400\" />\n            <span>\345\270\270\345\220\203\351\243\237\347\211\251\345\272\253</span>\n          </button>\n\n          <button\n            id=\"nav-tab-weight\"\n            onClick={() => setActiveTab(\'weight\')}\n            className={`flex items-center space-x-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all ${\n              activeTab === \'weight\'\n                ? \'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 shadow-sm\'\n                : \'text-stone-400 hover:text-stone-200 hover:bg-stone-800/50\'\n            }`}\n          >\n            <Scale className=\"w-4 h-4 text-blue-400\" />\n            <span>\351\253\224\351\207\215\350\266\250\345\213\242</span>\n          </button>\n\n          <button\n            id=\"nav-tab-water\"\n            onClick={() => setActiveTab(\'water\')}\n            className={`flex items-center space-x-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all ${\n              activeTab === \'water\'\n                ? \'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 shadow-sm\'\n                : \'text-stone-400 hover:text-stone-200 hover:bg-stone-800/50\'\n            }`}\n          >\n            <Droplet className=\"w-4 h-4 text-cyan-400\" />\n            <span>\345\226\235\346\260\264\347\264\200\351\214\204</span>\n          </button>\n\n          <button\n            id=\"nav-tab-settings\"\n            onClick={() => setActiveTab(\'settings\')}\n            className={`flex items-center space-x-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all ${\n              activeTab === \'settings\'\n                ? \'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 shadow-sm\'\n                : \'text-stone-400 hover:text-stone-200 hover:bg-stone-800/50\'\n            }`}\n          >\n            <Settings className=\"w-4 h-4 text-purple-400\" />\n            <span>BMR/TDEE \345\200\213\344\272\272\350\250\255\345\256\232</span>\n          </button>\n        </nav>\n      </div>\n    </header>\n  );\n};\n"
    }
