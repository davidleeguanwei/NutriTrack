    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { \n  UtensilsCrossed, \n  Plus, \n  Trash2, \n  Calendar, \n  Sparkles, \n  ChevronRight, \n  Coffee, \n  Sun, \n  Moon, \n  Cookie,\n  Flame\n} from \'lucide-react\';\nimport { FoodLog, MealType, FavoriteFood } from \'../types\';\nimport { formatDateLabel } from \'../lib/calculator\';\n\ninterface FoodLogSectionProps {\n  foodLogs: FoodLog[];\n  selectedDate: string;\n  favoriteFoods: FavoriteFood[];\n  onOpenAddModal: () => void;\n  onDeleteLog: (id: string) => void;\n  onQuickAddFavoriteFood: (fav: FavoriteFood) => void;\n}\n\nexport const FoodLogSection: React.FC<FoodLogSectionProps> = ({\n  foodLogs,\n  selectedDate,\n  favoriteFoods,\n  onOpenAddModal,\n  onDeleteLog,\n  onQuickAddFavoriteFood,\n}) => {\n  const totalCalories = foodLogs.reduce((acc, item) => acc + item.calories, 0);\n  const totalProtein = foodLogs.reduce((acc, item) => acc + item.proteinGrams, 0);\n  const totalCarbs = foodLogs.reduce((acc, item) => acc + item.carbsGrams, 0);\n  const totalFat = foodLogs.reduce((acc, item) => acc + item.fatGrams, 0);\n\n  const meals: { id: MealType; label: string; icon: React.ReactNode; color: string }[] = [\n    { id: \'breakfast\', label: \'\346\227\251\351\244\220 (Breakfast)\', icon: <Coffee className=\"w-4 h-4 text-amber-400\" />, color: \'amber\' },\n    { id: \'lunch\', label: \'\345\215\210\351\244\220 (Lunch)\', icon: <Sun className=\"w-4 h-4 text-emerald-400\" />, color: \'emerald\' },\n    { id: \'dinner\', label: \'\346\231\232\351\244\220 (Dinner)\', icon: <Moon className=\"w-4 h-4 text-indigo-400\" />, color: \'indigo\' },\n    { id: \'snack\', label: \'\351\273\236\345\277\203/\345\256\265\345\244\234 (Snack)\', icon: <Cookie className=\"w-4 h-4 text-pink-400\" />, color: \'pink\' },\n  ];\n\n  return (\n    <div id=\"foodlog-view\" className=\"space-y-6 animate-fade-in\">\n      {/* Header Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-stone-900 border border-stone-800 p-5 rounded-2xl shadow-md\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 rounded-full\">\n              {formatDateLabel(selectedDate)}\n            </span>\n            <span className=\"text-xs text-stone-400\">\346\257\217\346\227\245\351\243\262\351\243\237\350\250\230\351\214\204\350\210\207\346\210\220\345\210\206\346\213\206\350\247\243</span>\n          </div>\n          <h1 className=\"text-2xl font-black text-white mt-1 flex items-center gap-2\">\n            \351\243\262\351\243\237\346\227\245\350\250\230\346\227\245\350\250\230\350\210\207\346\210\220\345\210\206\350\251\263\347\264\260\350\263\207\350\250\212\n          </h1>\n          <p className=\"text-xs text-stone-400 mt-1\">\n            \347\225\266\346\227\245\347\264\200\351\214\204\347\206\261\351\207\217\357\274\232<strong className=\"text-emerald-400 font-bold\">{totalCalories}</strong> kcal | \n            \350\233\213\347\231\275\350\263\252 <strong className=\"text-sky-400\">{totalProtein}g</strong> | \n            \347\242\263\346\260\264 <strong className=\"text-amber-400\">{totalCarbs}g</strong> | \n            \350\204\202\350\202\252 <strong className=\"text-rose-400\">{totalFat}g</strong>\n          </p>\n        </div>\n\n        <button\n          id=\"add-food-log-section-btn\"\n          onClick={onOpenAddModal}\n          className=\"flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-stone-950 font-bold text-xs shadow-lg shadow-emerald-500/20 transition-all\"\n        >\n          <Plus className=\"w-4 h-4 stroke-[3]\" />\n          <span>\346\226\260\345\242\236\351\243\237\347\211\251\347\264\200\351\214\204</span>\n        </button>\n      </div>\n\n      {/* Quick Select from Favorites Bar */}\n      {favoriteFoods.length > 0 && (\n        <div className=\"bg-stone-900/90 border border-stone-800 rounded-2xl p-4 space-y-2\">\n          <span className=\"text-xs font-bold text-amber-400 flex items-center gap-1\">\n            <Sparkles className=\"w-4 h-4\" /> \344\270\200\351\215\265\345\276\236\343\200\214\345\270\270\345\220\203\351\243\237\347\211\251\345\272\253\343\200\215\345\212\240\345\205\245\344\273\212\346\227\245\351\243\262\351\243\237\357\274\232\n          </span>\n          <div className=\"flex flex-wrap gap-2 overflow-x-auto pb-1\">\n            {favoriteFoods.map((fav) => (\n              <button\n                key={fav.id || fav.foodName}\n                onClick={() => onQuickAddFavoriteFood(fav)}\n                className=\"px-3 py-1.5 rounded-xl bg-stone-950 hover:bg-emerald-950/80 border border-stone-800 hover:border-emerald-500/50 text-xs text-stone-200 hover:text-emerald-300 transition-all flex items-center gap-2 group\"\n              >\n                <span className=\"font-medium\">{fav.foodName}</span>\n                <span className=\"text-amber-400 font-bold text-[11px] group-hover:text-emerald-400\">\n                  +{fav.calories} kcal\n                </span>\n              </button>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* Meals Grouped Sections */}\n      <div className=\"space-y-4\">\n        {meals.map((meal) => {\n          const mealLogs = foodLogs.filter((f) => f.mealType === meal.id);\n          const mealCalories = mealLogs.reduce((sum, item) => sum + item.calories, 0);\n\n          return (\n            <div\n              key={meal.id}\n              className=\"bg-stone-900/90 border border-stone-800 rounded-2xl p-5 space-y-3 shadow-sm\"\n            >\n              {/* Meal Header */}\n              <div className=\"flex items-center justify-between border-b border-stone-800/80 pb-2.5\">\n                <div className=\"flex items-center space-x-2\">\n                  <div className=\"p-1.5 rounded-lg bg-stone-950 border border-stone-800\">\n                    {meal.icon}\n                  </div>\n                  <h3 className=\"text-sm font-bold text-stone-100\">{meal.label}</h3>\n                  <span className=\"text-xs text-stone-400 font-normal\">\n                    ({mealLogs.length} \351\240\205\347\264\200\351\214\204)\n                  </span>\n                </div>\n\n                <div className=\"flex items-center space-x-3\">\n                  <span className=\"text-xs font-extrabold text-amber-400 bg-amber-500/10 border border-amber-500/20 px-2.5 py-1 rounded-lg\">\n                    {mealCalories} kcal\n                  </span>\n                  <button\n                    onClick={onOpenAddModal}\n                    className=\"p-1 text-stone-400 hover:text-emerald-400 rounded-lg hover:bg-stone-800 transition-colors\"\n                    title=\"\345\234\250\346\255\244\351\244\220\345\210\245\346\226\260\345\242\236\347\264\200\351\214\204\"\n                  >\n                    <Plus className=\"w-4 h-4\" />\n                  </button>\n                </div>\n              </div>\n\n              {/* Logs List for Meal */}\n              {mealLogs.length === 0 ? (\n                <p className=\"text-xs text-stone-500 italic py-2 pl-2\">\n                  \345\260\232\346\234\252\347\231\273\351\214\204{meal.label.split(\' \')[0]}\351\244\220\351\273\236\357\274\214\351\273\236\346\223\212\343\200\214+\343\200\215\345\215\263\345\217\257\350\250\230\351\214\204\343\200\202\n                </p>\n              ) : (\n                <div className=\"divide-y divide-stone-800/60\">\n                  {mealLogs.map((log) => (\n                    <div\n                      key={log.id || log.foodName + log.calories}\n                      className=\"py-2.5 flex items-center justify-between hover:bg-stone-850/50 px-2 rounded-xl transition-colors group text-xs\"\n                    >\n                      <div className=\"space-y-0.5\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className=\"font-bold text-stone-100 text-sm\">{log.foodName}</span>\n                          {log.servingAmount && (\n                            <span className=\"text-[11px] text-stone-400 bg-stone-950 px-2 py-0.5 rounded border border-stone-800\">\n                              {log.servingAmount} {log.servingUnit || \'\344\273\275\'}\n                            </span>\n                          )}\n                        </div>\n\n                        {/* Nutrient details */}\n                        <div className=\"flex items-center gap-3 text-[11px] text-stone-400 font-mono\">\n                          <span>\350\233\213\347\231\275: <strong className=\"text-sky-400\">{log.proteinGrams}g</strong></span>\n                          <span>\347\242\263\346\260\264: <strong className=\"text-amber-400\">{log.carbsGrams}g</strong></span>\n                          <span>\350\204\202\350\202\252: <strong className=\"text-rose-400\">{log.fatGrams}g</strong></span>\n                          {log.fiberGrams ? <span>\347\272\226\347\266\255: <strong className=\"text-emerald-400\">{log.fiberGrams}g</strong></span> : null}\n                        </div>\n                      </div>\n\n                      <div className=\"flex items-center space-x-3\">\n                        <span className=\"font-extrabold text-amber-400 text-sm\">\n                          {log.calories} <span className=\"text-[10px] font-normal text-stone-400\">kcal</span>\n                        </span>\n                        {log.id && (\n                          <button\n                            onClick={() => onDeleteLog(log.id!)}\n                            className=\"p-1.5 text-stone-500 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition-colors opacity-80 group-hover:opacity-100\"\n                            title=\"\345\210\252\351\231\244\347\264\200\351\214\204\"\n                          >\n                            <Trash2 className=\"w-3.5 h-3.5\" />\n                          </button>\n                        )}\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              )}\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
