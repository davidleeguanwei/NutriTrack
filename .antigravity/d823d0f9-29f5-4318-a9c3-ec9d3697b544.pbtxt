        }
        lines {
          text: "  const totalCarbs = foodLogs.reduce((acc, item) => acc + (item.carbsGrams || 0), 0);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const totalFat = foodLogs.reduce((acc, item) => acc + (item.fatGrams || 0), 0);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const totalFiber = foodLogs.reduce((acc, item) => acc + (item.fiberGrams || 0), 0);"
