    replacement_chunks {
      replacement_content: "rules_version = \'2\';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n    \n    match /userProfiles/{docId} {\n      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;\n      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;\n    }\n    \n    match /foodLogs/{docId} {\n      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;\n      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;\n    }\n\n    match /weightLogs/{docId} {\n      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;\n      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;\n    }\n\n    match /waterLogs/{docId} {\n      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;\n      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;\n    }\n\n    match /favoriteFoods/{docId} {\n      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;\n      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;\n    }\n  }\n}\n"
    }
