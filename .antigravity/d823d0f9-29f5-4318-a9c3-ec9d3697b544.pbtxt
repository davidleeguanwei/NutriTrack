        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // BMR gap: how much more calories needed to hit BMR"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const caloriesNeededForBmr = Math.max(0, bmr - totalCalories);"
