          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Sorting logs by date ascending for chart"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const sortedLogs = [...weightLogs].sort((a, b) => a.date.localeCompare(b.date));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Key Statistics"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const latestLog = sortedLogs.length > 0 ? sortedLogs[sortedLogs.length - 1] : null;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const initialLog = sortedLogs.length > 0 ? sortedLogs[0] : null;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const currentWeight = latestLog ? latestLog.weightKg : profile.weight || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const initialWeight = initialLog ? initialLog.weightKg : currentWeight;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const weightChange = currentWeight && initialWeight ? Math.round((currentWeight - initialWeight) * 10) / 10 : 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const allWeights = sortedLogs.map((l) => l.weightKg);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const minWeight = allWeights.length > 0 ? Math.min(...allWeights) : currentWeight;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const maxWeight = allWeights.length > 0 ? Math.max(...allWeights) : currentWeight;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // BMI Calculation: weight (kg) / (height (m) ^ 2)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const heightM = profile.height ? profile.height / 100 : 1.65;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const bmi = currentWeight > 0 ? Math.round((currentWeight / (heightM * heightM)) * 10) / 10 : 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const getBmiCategory = (bmiVal: number) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (bmiVal < 18.5) return { label: \'\351\253\224\351\207\215\351\201\216\350\274\225\', color: \'text-amber-400\' };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (bmiVal < 24) return { label: \'\351\201\251\344\270\255\345\201\245\345\272\267\347\257\204\345\234\215\', color: \'text-emerald-400\' };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (bmiVal < 27) return { label: \'\351\253\224\351\207\215\351\201\216\351\207\215\', color: \'text-amber-400\' };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return { label: \'\350\202\245\350\203\226\347\255\211\347\264\232\', color: \'text-rose-400\' };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
